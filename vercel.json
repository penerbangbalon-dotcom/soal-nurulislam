{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "netlify/functions/_lib/logo-pkbm.png"
    }
  },
  "redirects": [
    { "source": "/data/:path*", "destination": "/", "permanent": false },
    { "source": "/supabase/:path*", "destination": "/", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/", "permanent": false },
    { "source": "/netlify/:path*", "destination": "/", "permanent": false },
    { "source": "/generate-soal.js", "destination": "/", "permanent": false },
    { "source": "/heartbeat.js", "destination": "/", "permanent": false },
    { "source": "/kelola-user.js", "destination": "/", "permanent": false },
    { "source": "/mulai-ujian.js", "destination": "/", "permanent": false },
    { "source": "/submit-ujian.js", "destination": "/", "permanent": false },
    { "source": "/sudahi-ujian.js", "destination": "/", "permanent": false },
    { "source": "/ujian-core.js", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/public/admin/:path*" },
    { "source": "/siswa/:path*", "destination": "/public/siswa/:path*" },
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" },
    { "source": "/absensi", "destination": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
